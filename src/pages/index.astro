---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="费德南多的世界"
  description="费德南多的世界 - 思考与分享"
>
  <div class="minimal-home">
    <div class="statement">
      <h1 class="main-title">思考与分享</h1>
      <p class="tagline">关于生活、技术与创作的零散记录</p>
    </div>
  </div>
</BaseLayout>

<style>
  .minimal-home {
    min-height: calc(70vh - 120px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 12vh;
  }

  .statement {
    max-width: 620px;
  }

  .main-title {
    font-family: var(--font-serif);
    font-size: 2.85rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1.25;
    color: var(--color-text);
    margin-bottom: var(--spacing-sm);
  }

  .tagline {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 0;
    letter-spacing: 0.02em;
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .minimal-home {
      min-height: 50vh;
      padding-bottom: 6vh;
    }
    .main-title {
      font-size: 2.2rem;
    }
    .tagline {
      font-size: 1.05rem;
    }
  }
</style>
