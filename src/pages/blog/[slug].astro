---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((item) => {
    const slug = item.slug || item.id.replace(/\.md$/, "");
    return {
      params: { slug },
      props: { item },
    };
  });
}

const { item } = Astro.props;
const { Content } = await render(item);
const { data } = item;
---

<BaseLayout
  title={`${data.title} - 见地 · 费德南多的世界`}
  description={data.description}
>
  <article class="post-detail">
    <div class="breadcrumb">
      <a href="/">首页</a> <span>/</span> <a href="/blog">见地</a> <span>/</span> <span>正文</span>
    </div>

    <header class="post-header">
      <div class="meta-line">
        <time datetime={new Date(data.date).toISOString()}>
          {new Date(data.date).toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        <span class="badge badge-outline">原创长文</span>
      </div>
      <h1>{data.title}</h1>
      {data.description && <p class="description">{data.description}</p>}
    </header>

    <div class="post-body">
      <Content />
    </div>

    <div class="post-nav">
      <a href="/blog">&larr; 返回见地列表</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post-detail {
    padding-top: var(--spacing-sm);
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
    margin-bottom: var(--spacing-md);
  }
  .breadcrumb a {
    color: var(--color-text-tertiary);
  }
  .breadcrumb a:hover {
    color: var(--color-accent);
  }
  .breadcrumb span {
    margin: 0 0.35rem;
  }
  .post-header {
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-lg);
  }
  .meta-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--spacing-xs);
  }
  .meta-line time {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
  }
  .post-header h1 {
    font-size: 2.3rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }
  .description {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 0;
  }
  .post-body {
    line-height: 1.85;
    font-size: 1.05rem;
  }
  .post-body :global(p) {
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
  }
  .post-body :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }
  .post-body :global(h3) {
    font-size: 1.25rem;
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-xs);
  }
  .post-nav {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
  }
  .post-nav a {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }
  .post-nav a:hover {
    color: var(--color-accent);
  }
</style>
