---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const items = await getCollection("commons");
items.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const categories = [...new Set(items.map((i) => i.data.category))];
---

<BaseLayout title="阅藏 · Commons - 费德南多的世界" description="文化储备、播客精读、AI 深度研报与历史地理考据">
  <div class="page-header">
    <div class="breadcrumb">
      <a href="/">首页</a> <span>/</span> <span>阅藏</span>
    </div>
    <h1>阅藏 · Commons</h1>
    <p class="tagline">文化储备、播客精读与深度考据图谱</p>
  </div>

  <div class="category-filter">
    <span class="filter-label">知识维度：</span>
    <span class="badge badge-accent">全部 ({items.length})</span>
    {categories.map((cat) => (
      <span class="badge badge-outline">{cat}</span>
    ))}
  </div>

  <div class="commons-list">
    {items.map((item) => {
      const slug = item.slug || item.id.replace(/\.md$/, "");
      return (
        <article class="commons-card">
          <div class="card-meta">
            <span class="badge badge-accent">{item.data.category}</span>
            <span class="source-tag">{item.data.sourceName}</span>
            {item.data.duration && <span class="duration-tag">⏱ {item.data.duration}</span>}
            <time datetime={new Date(item.data.date).toISOString()}>
              {new Date(item.data.date).toLocaleDateString("zh-CN", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          </div>

          <h2>
            <a href={`/commons/${slug}`}>{item.data.title}</a>
          </h2>

          <p class="desc">{item.data.description}</p>

          <div class="card-footer">
            <div class="tags">
              {item.data.tags.map((tag: string) => (
                <span class="tag-pill">#{tag}</span>
              ))}
            </div>
            <a href={`/commons/${slug}`} class="read-more">
              查阅研报 &rarr;
            </a>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: var(--spacing-lg) 0 var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-md);
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
    margin-bottom: var(--spacing-sm);
  }
  .breadcrumb a {
    color: var(--color-text-tertiary);
  }
  .breadcrumb a:hover {
    color: var(--color-accent);
  }
  .breadcrumb span {
    margin: 0 0.35rem;
  }
  .page-header h1 {
    font-size: 2.2rem;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
  }
  .tagline {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin-bottom: 0;
  }
  .category-filter {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: var(--spacing-sm) 0;
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .filter-label {
    font-size: 0.82rem;
    color: var(--color-text-tertiary);
    margin-right: 0.25rem;
  }
  .commons-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .commons-card {
    padding: var(--spacing-md);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    transition: border-color 0.15s ease;
  }
  .commons-card:hover {
    border-color: var(--color-text-tertiary);
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }
  .source-tag, .duration-tag, .card-meta time {
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
  }
  .commons-card h2 {
    font-size: 1.35rem;
    margin: 0 0 0.5rem 0;
    line-height: 1.35;
  }
  .commons-card h2 a {
    color: var(--color-text);
  }
  .commons-card h2 a:hover {
    color: var(--color-accent);
  }
  .desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--spacing-sm);
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: var(--spacing-xs);
    border-top: 1px solid var(--color-border-subtle);
  }
  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .tag-pill {
    font-size: 0.78rem;
    color: var(--color-text-tertiary);
  }
  .read-more {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-accent);
  }
</style>
